---
import BaseLayout from "./BaseLayout.astro";
import EmailSignup from "../components/EmailSignup.astro";

interface Props {
  title: string;
  description?: string;
  desk?: "finance" | "consulting" | "neutral";
}

const { title, description, desk = "neutral" } = Astro.props;

const deskVar =
  desk === "finance"
    ? "var(--accent)"
    : desk === "consulting"
      ? "var(--accent-2)"
      : "var(--ink-2)";
---

<BaseLayout title={title} description={description}>
  <article class="post" style={`--desk: ${deskVar}`} data-desk={desk}>
    <div class="post-inner">
      <header class="post-head">
        <slot name="kicker" />
        <h1>{title}</h1>
        <slot name="byline" />
        <slot name="standfirst" />
      </header>

      <div class="abovefold">
        <slot name="abovefold" />
      </div>

      <div class="prose">
        <slot />
      </div>

      <footer class="post-foot">
        <slot name="foot" />
      </footer>

      <EmailSignup variant="post" />
    </div>
  </article>

  <style>
    .post {
      padding-block: 2.5rem 3rem;
    }
    .post-inner {
      max-width: var(--page-max);
      margin-inline: auto;
      padding-inline: var(--page-pad);
    }

    .post-head {
      max-width: var(--measure);
    }
    .post-head h1 {
      font-size: clamp(1.75rem, 1.2rem + 2.4vw, 2.6rem);
      margin-block: 0.5rem 0.6rem;
    }

    .abovefold:not(:empty) {
      margin-top: 1.75rem;
    }

    .prose {
      max-width: var(--measure);
      margin-top: 2rem;
    }
    .prose :global(> * + *) {
      margin-top: var(--rhythm);
    }
    .prose :global(h2) {
      font-size: 1.4rem;
      margin-top: 2.75rem;
    }
    .prose :global(h3) {
      font-size: 1.15rem;
      margin-top: 2rem;
    }
    .prose :global(ul),
    .prose :global(ol) {
      padding-left: 1.25rem;
    }
    .prose :global(li + li) {
      margin-top: 0.4rem;
    }
    .prose :global(blockquote) {
      border-left: 3px solid var(--rule-strong);
      padding-left: 1rem;
      color: var(--ink-2);
    }
    .prose :global(pre) {
      background: var(--sunk);
      border: 1px solid var(--rule);
      padding: 1rem;
      border-radius: 2px;
      overflow-x: auto;
    }
    .prose :global(:not(pre) > code) {
      background: var(--sunk);
      padding: 0.1em 0.35em;
      border-radius: 2px;
    }
    .prose :global(a) {
      color: var(--desk);
    }
    .prose :global(.table-scroll) {
      overflow-x: auto;
    }
    .prose :global(table) {
      width: 100%;
      font-size: 0.9375rem;
    }
    .prose :global(th),
    .prose :global(td) {
      border-bottom: 1px solid var(--rule);
      padding: 0.5rem 0.75rem;
      text-align: left;
    }
    .prose :global(th) {
      font-family: var(--font-mono);
      font-size: 0.8125rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: var(--ink-3);
    }

    .post-foot {
      max-width: var(--measure);
    }
    .post-foot:not(:empty) {
      margin-top: 3.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--rule);
    }
  </style>
</BaseLayout>
