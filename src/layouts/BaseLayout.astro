---
import "../styles/global.css";
import EmailSignup from "../components/EmailSignup.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const year = new Date().getFullYear();

const nav = [
  { href: "/pitches", label: "Pitches" },
  { href: "/finance", label: "Finance" },
  { href: "/consulting", label: "Consulting" },
  { href: "/notes", label: "Notes" },
  { href: "/scorecard", label: "Scorecard" },
  { href: "/about", label: "About" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="AAwallet"
      href="/rss.xml"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/">AAwallet<span class="dot">.</span></a>
        <nav aria-label="Primary">
          {
            nav.map((n) => (
              <a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>
                {n.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <EmailSignup variant="footer" />
        <p class="legal">
          Educational content by undergraduate students. Not investment advice,
          not a recommendation to buy or sell any security. Positions disclosed
          on every pitch. <a href="/disclaimer">See full disclaimer</a>.
        </p>
        <p class="colophon">
          <span class="tnum">&copy;&nbsp;{year}</span> AAwallet
        </p>
      </div>
    </footer>

    <style>
      .wrap {
        max-width: var(--page-max);
        margin-inline: auto;
        padding-inline: var(--page-pad);
      }

      .skip {
        position: absolute;
        left: -9999px;
        z-index: 10;
      }
      .skip:focus {
        left: var(--page-pad);
        top: 0.5rem;
        background: var(--surface);
        color: var(--ink);
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--rule-strong);
        border-radius: 2px;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 20;
        background: color-mix(in oklab, var(--surface) 88%, transparent);
        border-bottom: 1px solid var(--rule);
        backdrop-filter: saturate(1.4) blur(8px);
        -webkit-backdrop-filter: saturate(1.4) blur(8px);
      }
      .site-header .wrap {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.5rem 1.5rem;
        padding-block: 0.9rem;
      }
      .wordmark {
        font-family: var(--font-serif);
        font-weight: 600;
        font-size: 1.2rem;
        letter-spacing: -0.01em;
        color: var(--ink);
        text-decoration: none;
      }
      .wordmark .dot {
        color: var(--accent);
      }
      .site-header nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem 1.15rem;
      }
      .site-header nav a {
        position: relative;
        font-family: var(--font-mono);
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--ink-3);
        text-decoration: none;
        padding-bottom: 0.15rem;
      }
      .site-header nav a:hover {
        color: var(--ink);
      }
      .site-header nav a[aria-current="page"] {
        color: var(--ink);
      }
      .site-header nav a[aria-current="page"]::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -0.9rem;
        height: 2px;
        background: var(--accent);
      }

      main {
        min-height: 60vh;
      }

      .site-footer {
        margin-top: 5rem;
        background: var(--surface);
        border-top: 2px solid var(--accent);
      }
      .site-footer .wrap {
        padding-block: 2rem;
      }
      .legal {
        max-width: var(--measure);
        font-size: 0.875rem;
        color: var(--ink-3);
      }
      .legal a {
        color: var(--ink-2);
      }
      .colophon {
        margin-top: 0.75rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--ink-3);
      }
    </style>
  </body>
</html>
