---
import "../styles/global.css";
import EmailSignup from "../components/EmailSignup.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const year = new Date().getFullYear();

const nav = [
  { href: "/finance", label: "Finance" },
  { href: "/cases", label: "Casebook" },
  { href: "/glossary", label: "Glossary" },
  { href: "/about", label: "About" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="AAwallet"
      href="/rss.xml"
    />
    <script is:inline>
      // Apply a saved theme before paint, so there's no flash of the wrong
      // theme. No preference saved = falls through to the OS setting, which
      // tokens.css already handles via prefers-color-scheme.
      try {
        var saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") {
          document.documentElement.setAttribute("data-theme", saved);
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/">AAwallet<span class="dot">.</span></a>
        <nav aria-label="Primary">
          {
            nav.map((n) => (
              <a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>
                {n.label}
              </a>
            ))
          }
        </nav>
        <button
          type="button"
          class="theme-toggle"
          id="theme-toggle"
          aria-label="Switch between light and dark"
        >
          <span class="tt-icon tt-sun" aria-hidden="true">☀</span>
          <span class="tt-icon tt-moon" aria-hidden="true">☾</span>
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <EmailSignup variant="footer" />
        <p class="legal">
          Educational content by undergraduate students. Not investment advice,
          not a recommendation to buy or sell any security. Positions disclosed
          on every pitch. <a href="/disclaimer">See full disclaimer</a>.
        </p>
        <p class="colophon">
          <span class="tnum">&copy;&nbsp;{year}</span> AAwallet
        </p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;
        var root = document.documentElement;
        function current() {
          var saved = root.getAttribute("data-theme");
          if (saved) return saved;
          return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }
        btn.addEventListener("click", function () {
          var next = current() === "dark" ? "light" : "dark";
          root.setAttribute("data-theme", next);
          try {
            localStorage.setItem("theme", next);
          } catch (e) {}
        });
      })();
    </script>

    <style>
      .wrap {
        max-width: var(--page-max);
        margin-inline: auto;
        padding-inline: var(--page-pad);
      }

      .skip {
        position: absolute;
        left: -9999px;
        z-index: 30;
      }
      .skip:focus {
        left: var(--page-pad);
        top: 0.5rem;
        background: var(--surface);
        color: var(--ink);
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--rule-strong);
        border-radius: 2px;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 20;
        background: var(--masthead);
        border-bottom: 2px solid var(--accent);
      }
      .site-header .wrap {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem 1.5rem;
        padding-block: 0.85rem;
      }
      .wordmark {
        font-family: var(--font-serif);
        font-weight: 600;
        font-size: 1.2rem;
        letter-spacing: -0.01em;
        color: var(--on-masthead);
        text-decoration: none;
      }
      .wordmark .dot {
        color: var(--accent);
      }
      .site-header nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem 1.25rem;
        margin-inline-start: auto;
      }
      .site-header nav a {
        position: relative;
        font-family: var(--font-mono);
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        color: var(--on-masthead-muted);
        text-decoration: none;
        padding-bottom: 0.15rem;
      }
      .site-header nav a:hover {
        color: var(--on-masthead);
      }
      .site-header nav a[aria-current="page"] {
        color: var(--on-masthead);
      }
      .site-header nav a[aria-current="page"]::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -0.9rem;
        height: 2px;
        background: var(--accent);
      }

      .theme-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.9rem;
        height: 1.9rem;
        margin-left: 1rem;
        padding: 0;
        background: transparent;
        border: 1px solid var(--on-masthead-muted);
        border-radius: 999px;
        color: var(--on-masthead);
        cursor: pointer;
        line-height: 1;
      }
      .theme-toggle:hover {
        border-color: var(--accent);
        color: var(--accent);
      }
      .tt-icon {
        font-size: 0.85rem;
      }
      .tt-moon {
        display: none;
      }
      :global([data-theme="dark"]) .tt-sun {
        display: none;
      }
      :global([data-theme="dark"]) .tt-moon {
        display: inline;
      }
      @media (prefers-color-scheme: dark) {
        :global(html:not([data-theme="light"])) .tt-sun {
          display: none;
        }
        :global(html:not([data-theme="light"])) .tt-moon {
          display: inline;
        }
      }

      main {
        min-height: 55vh;
      }

      .site-footer {
        margin-top: 3rem;
        background: var(--surface);
        border-top: 2px solid var(--accent);
      }
      .site-footer .wrap {
        padding-block: 1.5rem;
      }
      .legal {
        max-width: var(--measure);
        font-size: 0.875rem;
        color: var(--ink-3);
      }
      .legal a {
        color: var(--ink-2);
      }
      .colophon {
        margin-top: 0.75rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--ink-3);
      }
    </style>
  </body>
</html>
