---
import type { PostItem } from "../lib/posts";
import Byline from "./Byline.astro";
import StatusBadge from "./StatusBadge.astro";

interface Props {
  item: PostItem;
  /** Denser layout for long single-type feeds (e.g. the Finance pitch list). */
  compact?: boolean;
}

const { item, compact = false } = Astro.props;

const deskVar =
  item.desk === "finance"
    ? "var(--accent)"
    : item.desk === "consulting"
      ? "var(--accent-2)"
      : "var(--ink-2)";

const typeLabel =
  item.type === "pitch" ? "Pitch" : item.type === "case" ? "Case" : "Note";
---

<article class="row" class:list={{ compact }} style={`--desk: ${deskVar}`}>
  <p class="row-meta">
    <span class="type">{typeLabel}</span>
    {item.ticker && <span class="tkr">{item.ticker}</span>}
    {
      item.direction && (
        <span class="dir" data-dir={item.direction}>
          {item.direction}
        </span>
      )
    }
    {item.caseType && <span class="ctype">{item.caseType.replace(/-/g, " ")}</span>}
    {item.status && <StatusBadge status={item.status} />}
  </p>
  <h3 class="row-title"><a href={item.href}>{item.title}</a></h3>
  <Byline
    authorName={item.authorName}
    authorSlug={item.authorId}
    desk={item.desk}
    date={item.publishedAt}
  />
</article>

<style>
  .row {
    position: relative;
    padding: 1.25rem 1rem 1.3rem 1.1rem;
    border-bottom: 1px solid var(--rule);
    margin-inline: -1rem;
    border-radius: 3px;
    transition: background 0.12s ease;
  }
  .row::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.9rem;
    bottom: 0.9rem;
    width: 2px;
    background: var(--desk, var(--rule-strong));
    opacity: 0;
    transition: opacity 0.12s ease;
  }
  .row:hover {
    background: color-mix(in oklab, var(--desk, var(--ink-3)) 5%, var(--surface));
  }
  .row:hover::before {
    opacity: 1;
  }
  .row-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }
  .type {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
    color: var(--desk, var(--ink-2));
  }
  .tkr {
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--ink);
  }
  .dir {
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    color: var(--ink-2);
  }
  .dir[data-dir="long"] {
    color: var(--good);
    border-color: var(--good);
  }
  .dir[data-dir="short"] {
    color: var(--crit);
    border-color: var(--crit);
  }
  .ctype {
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }
  .row-title {
    font-size: 1.3rem;
    margin-block: 0.4rem 0.1rem;
  }
  .row-title a {
    color: var(--ink);
    text-decoration: none;
  }
  .row:hover .row-title a {
    color: var(--desk, var(--ink));
  }

  /* Compact — dense headline-list feel, no oversized gaps between items. */
  .row.compact {
    padding-block: 0.75rem 0.8rem;
  }
  .row.compact .row-title {
    font-size: 1.05rem;
    margin-block: 0.25rem 0.05rem;
  }
  .row.compact .row-meta {
    font-size: 0.68rem;
  }
</style>
