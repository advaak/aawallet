---
interface Props {
  authorName: string;
  authorSlug: string;
  desk: string;
  date: Date;
}

const { authorName, authorSlug, desk, date } = Astro.props;

const iso = date.toISOString().slice(0, 10);
const human = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
const deskLabel =
  desk === "finance"
    ? "Finance desk"
    : desk === "consulting"
      ? "Consulting desk"
      : "Both desks";
---

<p class="byline">
  <a href={`/authors/${authorSlug}`}>{authorName}</a>
  <span class="sep" aria-hidden="true">·</span>
  <span class="desk">{deskLabel}</span>
  <span class="sep" aria-hidden="true">·</span>
  <time datetime={iso}>{human}</time>
</p>

<style>
  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  .byline a {
    color: var(--ink-2);
    text-decoration: none;
  }
  .byline a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .desk {
    color: var(--desk, var(--ink-3));
  }
  .sep {
    color: var(--rule-strong);
  }
</style>
