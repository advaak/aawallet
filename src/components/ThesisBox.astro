---
interface Props {
  thesis: string[];
}

const { thesis } = Astro.props;
---

<section class="thesis" aria-label="Thesis">
  <p class="kicker">Thesis</p>
  <ol>
    {thesis.map((t) => <li>{t}</li>)}
  </ol>
</section>

<style>
  .thesis {
    border: 1px solid var(--rule);
    border-left: 3px solid var(--desk, var(--accent));
    background: var(--sunk);
    padding: 1.25rem 1.5rem;
    border-radius: 2px;
  }
  .kicker {
    margin-bottom: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }
  ol {
    padding-left: 1.3rem;
    display: grid;
    gap: 0.5rem;
  }
  li {
    padding-left: 0.25rem;
  }
</style>
