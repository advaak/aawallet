---
import { renderChart, type ChartType } from "../lib/chart";

interface Props {
  src: string;
  type?: ChartType;
  x: string;
  y: string;
  caption?: string;
  /** Force a desk accent; defaults to the surrounding post's --desk. */
  accent?: "finance" | "consulting";
}

const { src, type = "line", x, y, caption, accent } = Astro.props;

const { svg, rowCount } = renderChart({ src, type, x, y });

// Default to the site primary (--accent). Pass accent="consulting" on a
// consulting-desk note to switch. Desk colours are never mixed on one page.
const accentVar =
  accent === "consulting" ? "var(--accent-2)" : "var(--accent)";

const fileName = src.split("/").pop() ?? "data.csv";
---

<figure class="chart" style={`--chart-accent: ${accentVar}`}>
  <div class="chart-frame" set:html={svg} />
  {caption && <figcaption>{caption}</figcaption>}
  <p class="chart-data">
    <a href={src} download>Download the data</a>
    <span class="meta">· {fileName} · {rowCount} rows</span>
  </p>
</figure>

<style>
  .chart {
    margin-block: 2rem;
  }
  .chart-frame {
    overflow-x: auto;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: var(--surface);
    padding: 0.75rem 0.75rem 0.25rem;
  }
  .chart-frame :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
  }
  figcaption {
    margin-top: 0.6rem;
    max-width: var(--measure);
    font-size: 0.9375rem;
    color: var(--ink-2);
  }
  .chart-data {
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-3);
  }
  .chart-data a {
    color: var(--desk, var(--accent));
  }
  .meta {
    margin-left: 0.25rem;
  }
</style>
