---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import AuthorCard from "./AuthorCard.astro";
import PostRow from "./PostRow.astro";
import { getCaseItems } from "../lib/posts";

interface Props {
  desk: "finance" | "consulting";
  blurb: string;
}

const { desk, blurb } = Astro.props;

// Canonical caseType order (SPEC §3 enum) so groups render predictably.
const CASE_TYPE_ORDER: CollectionEntry<"cases">["data"]["caseType"][] = [
  "paper-lbo",
  "dcf",
  "comps",
  "accretion-dilution",
  "merger-math",
  "market-sizing",
  "profitability",
  "market-entry",
  "pricing",
  "growth-strategy",
];

const authors = await getCollection("authors");
const lead = authors.find((a) => a.data.desk === desk);

const cases = (await getCaseItems()).filter((c) => c.desk === desk);
const groups = CASE_TYPE_ORDER.map((type) => ({
  type,
  label: type.replace(/-/g, " "),
  items: cases.filter((c) => c.caseType === type),
})).filter((g) => g.items.length > 0);

const deskName = desk === "finance" ? "Finance" : "Consulting";
---

<div class="container stack-lg desk-landing" data-desk={desk}>
  <header class="measure">
    <p class="kicker">{deskName} desk</p>
    <h1>{deskName}</h1>
    <p class="blurb">{blurb}</p>
  </header>

  {
    lead ? (
      <div class="measure">
        <AuthorCard
          name={lead.data.name}
          slug={lead.id}
          role={lead.data.role}
          bio={lead.data.bio}
          desk={desk}
          links={lead.data.links}
        />
      </div>
    ) : (
      <p class="measure tba">Desk lead: to be announced.</p>
    )
  }

  <section class="measure" aria-label="Cases by type">
    <p class="kicker section-head">Cases</p>
    {
      groups.length === 0 ? (
        <p class="empty">
          No {deskName.toLowerCase()} cases published yet. Drafts show in local
          development only.
        </p>
      ) : (
        <div class="stack-lg">
          {groups.map((g) => (
            <div class="group">
              <h2>{g.label}</h2>
              <div>
                {g.items.map((item) => (
                  <PostRow item={item} />
                ))}
              </div>
            </div>
          ))}
        </div>
      )
    }
  </section>
</div>

<style>
  .desk-landing {
    padding-block: 2.5rem 1rem;
  }
  .kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  [data-desk="consulting"] .kicker {
    color: var(--accent-2);
  }
  h1 {
    font-size: clamp(1.8rem, 1.3rem + 2vw, 2.4rem);
    margin-block: 0.35rem 0.5rem;
  }
  .blurb {
    color: var(--ink-2);
  }
  .section-head {
    display: block;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--rule-strong);
    color: var(--ink-3);
  }
  .group h2 {
    font-size: 1.05rem;
    text-transform: capitalize;
    color: var(--ink-2);
    margin-bottom: 0.25rem;
  }
  .tba,
  .empty {
    color: var(--ink-3);
  }
</style>
