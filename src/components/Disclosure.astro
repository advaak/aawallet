---
interface Props {
  price: number;
  currency: string;
  date: Date;
  disclosure: string;
}

const { price, currency, date, disclosure } = Astro.props;

const iso = date.toISOString().slice(0, 10);
const human = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});

let priceStr: string;
try {
  priceStr = new Intl.NumberFormat("en-US", {
    style: "currency",
    currency,
  }).format(price);
} catch {
  priceStr = `${price.toFixed(2)} ${currency}`;
}
---

<aside class="disclosure">
  <p>
    Price at publication: <span class="fig">{priceStr}</span> on
    <time datetime={iso}>{human}</time>. This analysis is not updated for
    subsequent price movement. Author's position: {disclosure}
  </p>
</aside>

<style>
  .disclosure {
    max-width: var(--measure);
    border: 1px solid var(--rule-strong);
    background: var(--sunk);
    padding: 0.9rem 1.1rem;
    border-radius: 2px;
    font-size: 0.875rem;
    color: var(--ink-2);
  }
  .fig {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
</style>
