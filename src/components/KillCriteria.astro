---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<section class="kill" aria-label="Kill criteria">
  <p class="kicker">Kill criteria</p>
  <p class="lede">What would prove this thesis wrong:</p>
  <ul>
    {items.map((i) => <li>{i}</li>)}
  </ul>
</section>

<style>
  .kill {
    border: 1px solid var(--rule);
    border-left: 3px solid var(--crit);
    background: color-mix(in oklab, var(--crit) 5%, var(--surface));
    padding: 1.25rem 1.5rem;
    border-radius: 2px;
  }
  .kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--crit);
  }
  .lede {
    margin-top: 0.35rem;
    margin-bottom: 0.6rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }
  ul {
    padding-left: 1.3rem;
    display: grid;
    gap: 0.5rem;
  }
  li {
    padding-left: 0.25rem;
  }
</style>
