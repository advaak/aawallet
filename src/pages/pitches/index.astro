---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostRow from "../../components/PostRow.astro";
import { getPitchItems } from "../../lib/posts";

const pitches = await getPitchItems();
---

<BaseLayout
  title="Pitches — AAwallet"
  description="Every stock pitch: thesis in three bullets, explicit kill criteria, a linked model, and the bear case written to win."
>
  <div class="container stack measure page">
    <header>
      <p class="kicker">Pitches</p>
      <h1>Pitches</h1>
      <p class="lede">
        Newest first. Each pitch states its kill criteria and links a real model.
        Thesis status for all of them lives on the <a href="/scorecard">scorecard</a>.
      </p>
    </header>

    {
      pitches.length === 0 ? (
        <p class="empty">
          No pitches published yet. Drafts show in local development only.
        </p>
      ) : (
        <div>
          {pitches.map((item) => (
            <PostRow item={item} />
          ))}
        </div>
      )
    }
  </div>

  <style>
    .page {
      padding-block: 2.5rem 1rem;
    }
    .kicker {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--ink-3);
    }
    h1 {
      font-size: clamp(1.8rem, 1.3rem + 2vw, 2.4rem);
      margin-block: 0.35rem 0.5rem;
    }
    .lede {
      color: var(--ink-2);
    }
    .empty {
      color: var(--ink-3);
    }
  </style>
</BaseLayout>
