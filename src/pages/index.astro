---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostRow from "../components/PostRow.astro";
import { getAllPosts } from "../lib/posts";

const latest = (await getAllPosts()).slice(0, 6);

const cards = [
  {
    href: "/finance",
    title: "Finance",
    desc: "Weekly finance news and stock pitches — thesis in three bullets, explicit kill criteria, a real model attached.",
    desk: "finance",
  },
  {
    href: "/cases",
    title: "Casebook",
    desc: "Real interview problems, finance and consulting both — solved in the open, wrong turns kept in.",
    desk: "consulting",
  },
  {
    href: "/glossary",
    title: "Glossary",
    desc: "Every pitch, case, and note published here, with its date and author, in one place.",
    desk: null,
  },
  {
    href: "/about",
    title: "About",
    desc: "Who writes this, what it is, and what it isn't.",
    desk: null,
  },
];

const deskVar = (d: string | null) =>
  d === "finance"
    ? "var(--accent)"
    : d === "consulting"
      ? "var(--accent-2)"
      : "var(--ink-2)";
---

<BaseLayout
  title="AAwallet"
  description="Stock pitches and worked finance & consulting cases, written by two undergraduates. Every pitch states its kill criteria; every case keeps the wrong turn in."
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-text">
        <p class="kicker">Finance · Casebook · Glossary</p>
        <h1>Analysis you can check.</h1>
        <p class="hero-lede">
          Stock pitches and worked finance &amp; consulting cases. Show the
          arithmetic, state the assumptions, say what would prove the thesis
          wrong.
        </p>
      </div>
      <nav class="cards" aria-label="Sections">
        {
          cards.map((c) => (
            <a class="card" href={c.href} style={`--desk: ${deskVar(c.desk)}`}>
              <span class="card-title">
                {c.title}
                <span class="arrow" aria-hidden="true">
                  →
                </span>
              </span>
              <span class="card-desc">{c.desc}</span>
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <div class="container home">
    <section class="latest measure" aria-label="Latest posts">
      <p class="kicker section-head">Latest</p>
      {
        latest.length === 0 ? (
          <p class="empty">
            No posts published yet. Draft posts are visible in local development
            only.
          </p>
        ) : (
          <div class="rows">
            {latest.map((item) => (
              <PostRow item={item} compact />
            ))}
          </div>
        )
      }
    </section>
  </div>

  <style>
    .hero {
      background: var(--wash);
      border-bottom: 1px solid var(--rule);
      padding-block: 1.75rem;
    }
    .hero-grid {
      display: grid;
      grid-template-columns: 1.3fr 1fr;
      gap: 2rem;
      align-items: start;
    }
    @media (max-width: 52rem) {
      .hero-grid {
        grid-template-columns: 1fr;
        gap: 1.25rem;
      }
    }
    .hero .kicker {
      color: var(--accent);
    }
    .hero h1 {
      max-width: 16ch;
      font-size: clamp(1.6rem, 1.2rem + 2vw, 2.35rem);
      margin-block: 0.3rem 0.5rem;
    }
    .hero-lede {
      max-width: 46ch;
      font-size: 0.95rem;
      color: var(--ink-2);
    }

    .home {
      padding-block: 1.5rem 1rem;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.6rem;
      align-content: start;
    }
    .card {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      padding: 0.75rem 0.85rem 0.85rem;
      background: var(--surface);
      border: 1px solid var(--rule);
      border-top: 2px solid var(--desk);
      border-radius: 2px;
      text-decoration: none;
      transition:
        border-color 0.12s ease,
        background 0.12s ease;
    }
    .card:hover {
      border-color: var(--desk);
      background: color-mix(in oklab, var(--desk) 5%, var(--surface));
    }
    .card-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-family: var(--font-serif);
      font-size: 1rem;
      font-weight: 600;
      color: var(--ink);
    }
    .arrow {
      font-family: var(--font-mono);
      color: var(--desk);
      transition: transform 0.12s ease;
    }
    .card:hover .arrow {
      transform: translateX(3px);
    }
    .card-desc {
      font-size: 0.78rem;
      line-height: 1.4;
      color: var(--ink-3);
    }

    .section-head {
      display: block;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--rule-strong);
    }
    .rows {
      margin-top: 0.25rem;
    }
    .empty {
      margin-top: 1rem;
      color: var(--ink-3);
    }
  </style>
</BaseLayout>
