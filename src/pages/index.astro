---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostRow from "../components/PostRow.astro";
import { getAllPosts } from "../lib/posts";

const latest = (await getAllPosts()).slice(0, 6);

const cards = [
  {
    href: "/pitches",
    title: "Pitches",
    desc: "A thesis in three bullets, explicit kill criteria, and a real model attached.",
    desk: "finance",
  },
  {
    href: "/scorecard",
    title: "Scorecard",
    desc: "Every pitch and whether its thesis still holds. No returns column, on purpose.",
    desk: null,
  },
  {
    href: "/finance",
    title: "Finance desk",
    desc: "Paper LBO, DCF, comps, merger math — worked the way an interviewer states them.",
    desk: "finance",
  },
  {
    href: "/consulting",
    title: "Consulting desk",
    desc: "Market sizing, profitability, pricing, growth — structured cold, wrong turns kept in.",
    desk: "consulting",
  },
];

const deskVar = (d: string | null) =>
  d === "finance"
    ? "var(--accent)"
    : d === "consulting"
      ? "var(--accent-2)"
      : "var(--ink-2)";
---

<BaseLayout
  title="AAwallet"
  description="Stock pitches and worked finance & consulting cases, written by two undergraduates. Every pitch states its kill criteria; every case keeps the wrong turn in."
>
  <section class="hero">
    <div class="container">
      <p class="kicker">Pitches · Cases · Notes</p>
      <h1>Analysis you can check.</h1>
      <p class="hero-lede">
        AAwallet publishes stock pitches and worked finance &amp; consulting
        interview cases. Two desks, two authors, one standard: show the
        arithmetic, state the assumptions, and say what would prove the thesis
        wrong.
      </p>
    </div>
  </section>

  <div class="container home stack-lg">
    <section class="cards" aria-label="Sections">
      {
        cards.map((c) => (
          <a class="card" href={c.href} style={`--desk: ${deskVar(c.desk)}`}>
            <span class="card-title">
              {c.title}
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </span>
            <span class="card-desc">{c.desc}</span>
          </a>
        ))
      }
    </section>

    <p class="about-line">
      New here? <a href="/about">What this is, and what it isn't →</a>
    </p>

    <section class="latest measure" aria-label="Latest posts">
      <p class="kicker section-head">Latest</p>
      {
        latest.length === 0 ? (
          <p class="empty">
            No posts published yet. Draft posts are visible in local development
            only.
          </p>
        ) : (
          <div class="rows">
            {latest.map((item) => (
              <PostRow item={item} />
            ))}
          </div>
        )
      }
    </section>
  </div>

  <style>
    .hero {
      background: var(--wash);
      border-bottom: 1px solid var(--rule);
      padding-block: clamp(3rem, 1.5rem + 7vw, 6rem);
    }
    .hero .kicker {
      color: var(--accent);
    }
    .hero h1 {
      max-width: 20ch;
      font-size: clamp(2.4rem, 1.5rem + 5vw, 4.25rem);
      margin-block: 0.6rem 1rem;
    }
    .hero-lede {
      max-width: 58ch;
      font-size: clamp(1.05rem, 1rem + 0.4vw, 1.2rem);
      color: var(--ink-2);
    }

    .home {
      padding-block: 3rem 1rem;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
      gap: 1rem;
    }
    .card {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      padding: 1.25rem 1.35rem 1.4rem;
      background: var(--surface);
      border: 1px solid var(--rule);
      border-top: 2px solid var(--desk);
      border-radius: 3px;
      text-decoration: none;
      transition:
        transform 0.12s ease,
        border-color 0.12s ease,
        background 0.12s ease;
    }
    .card:hover {
      transform: translateY(-2px);
      border-color: var(--desk);
      background: color-mix(in oklab, var(--desk) 5%, var(--surface));
    }
    .card-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-family: var(--font-serif);
      font-size: 1.2rem;
      font-weight: 600;
      color: var(--ink);
    }
    .arrow {
      font-family: var(--font-mono);
      color: var(--desk);
      transition: transform 0.12s ease;
    }
    .card:hover .arrow {
      transform: translateX(3px);
    }
    .card-desc {
      font-size: 0.9rem;
      line-height: 1.55;
      color: var(--ink-3);
    }

    .about-line {
      font-size: 0.9375rem;
      color: var(--ink-3);
    }
    .about-line a {
      color: var(--ink-2);
    }

    .section-head {
      display: block;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--rule-strong);
    }
    .rows {
      margin-top: 0.5rem;
    }
    .empty {
      margin-top: 1rem;
      color: var(--ink-3);
    }
  </style>
</BaseLayout>
