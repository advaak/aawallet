---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostRow from "../../components/PostRow.astro";
import { getPostsByAuthor } from "../../lib/posts";

export async function getStaticPaths() {
  const authors = await getCollection("authors");
  return authors.map((author) => ({
    params: { slug: author.id },
    props: { author },
  }));
}

const { author } = Astro.props;
const a = author.data;
const posts = await getPostsByAuthor(author.id);

const deskName = a.desk === "finance" ? "Finance" : "Consulting";
const deskVar = a.desk === "finance" ? "var(--accent)" : "var(--accent-2)";
const links = a.links ?? {};
const hasLinks = Boolean(links.linkedin || links.github || links.email);
---

<BaseLayout title={`${a.name} — AAwallet`} description={a.bio}>
  <div class="container stack-lg author measure" style={`--desk: ${deskVar}`}>
    <header class="stack">
      <p class="kicker">{deskName} desk</p>
      <h1>{a.name}</h1>
      <p class="role">{a.role}</p>
      <p class="bio">{a.bio}</p>
      {
        hasLinks && (
          <p class="links">
            {links.linkedin && <a href={links.linkedin}>LinkedIn</a>}
            {links.github && <a href={links.github}>GitHub</a>}
            {links.email && <a href={`mailto:${links.email}`}>Email</a>}
          </p>
        )
      }
    </header>

    <section aria-label="Posts by this author">
      <p class="kicker section-head">Published work</p>
      {
        posts.length === 0 ? (
          <p class="empty">
            Nothing published yet. Drafts show in local development only.
          </p>
        ) : (
          <div>
            {posts.map((item) => (
              <PostRow item={item} />
            ))}
          </div>
        )
      }
    </section>
  </div>

  <style>
    .author {
      padding-block: 2.5rem 1rem;
    }
    .kicker {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--desk, var(--ink-3));
    }
    h1 {
      font-size: clamp(1.9rem, 1.3rem + 2.4vw, 2.6rem);
    }
    .role {
      font-family: var(--font-mono);
      font-size: 0.8125rem;
      color: var(--ink-3);
    }
    .bio {
      color: var(--ink-2);
    }
    .links {
      display: flex;
      gap: 1rem;
      font-family: var(--font-mono);
      font-size: 0.8125rem;
    }
    .links a {
      color: var(--ink-2);
    }
    .section-head {
      display: block;
      padding-bottom: 0.6rem;
      border-bottom: 1px solid var(--rule-strong);
      color: var(--ink-3);
      margin-bottom: 0.25rem;
    }
    .empty {
      color: var(--ink-3);
    }
  </style>
</BaseLayout>
